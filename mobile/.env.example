# Địa chỉ API mà app gọi tới:
# - Máy ảo Android: http://10.0.2.2:4000/api
# - Máy ảo iOS / bản web: http://localhost:4000/api
# - Điện thoại thật (cùng wifi): http://<IP-máy-tính>:4000/api   (vd http://192.168.1.10:4000/api)
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
# Trang web (ảnh minh hoạ sản phẩm mẫu, trang kết quả VNPay & đặt lại mật khẩu)
# - Máy ảo Android: http://10.0.2.2:3000 · iOS / web: http://localhost:3000 · Điện thoại thật: http://<IP-máy-tính>:3000
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:3000

# UUID dự án lấy từ `npx eas-cli@latest init`; bắt buộc để nhận Expo Push Token ở bản development/local.
# EAS Build cũng tự cung cấp Constants.easConfig.projectId cho binary đã liên kết.
EXPO_PUBLIC_EAS_PROJECT_ID=
