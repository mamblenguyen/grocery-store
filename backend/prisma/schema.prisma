generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" = runtime của Vercel Functions (build trên GitHub Actions rồi deploy --prebuilt)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  // vd: mysql://root:root@localhost:3306/grocery
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum InventoryReason {
  IMPORT
  ORDER
  CANCEL
  ADJUST
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  fullName  String
  phone     String?
  address   String?  @db.Text
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders        Order[]
  inventoryLogs InventoryLog[]
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?    @db.Text
  image       String?    @db.VarChar(1000)
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  parentId    Int?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?   @db.Text
  brand       String?
  unit        String? // đơn vị tính: gói, chai, hộp, kg...
  thumbnail   String?   @db.VarChar(1000)
  images      Json? // mảng URL ảnh: ["https://...", ...]
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  // Giá thấp nhất / cao nhất trong các biến thể (denormalized để lọc & sắp xếp)
  minPrice    Int       @default(0)
  maxPrice    Int       @default(0)
  soldCount   Int       @default(0)
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  options  ProductOption[]
  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

// Ví dụ: "Khối lượng", "Hương vị"
model ProductOption {
  id        Int                  @id @default(autoincrement())
  productId Int
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int                  @default(0)
  values    ProductOptionValue[]
}

// Ví dụ: "500g", "1kg", "Cay", "Không cay"
model ProductOptionValue {
  id       Int                  @id @default(autoincrement())
  optionId Int
  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value    String
  position Int                  @default(0)
  variants VariantOptionValue[]
}

model ProductVariant {
  id                Int     @id @default(autoincrement())
  productId         Int
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String  @unique
  barcode           String?
  name              String // "1kg / Cay" – tự sinh từ option values
  price             Int
  compareAtPrice    Int? // giá gốc (gạch ngang)
  costPrice         Int? // giá nhập
  stock             Int     @default(0)
  lowStockThreshold Int     @default(5)
  image             String? @db.VarChar(1000)
  isActive          Boolean @default(true)
  position          Int     @default(0)

  optionValues  VariantOptionValue[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model VariantOptionValue {
  variantId     Int
  optionValueId Int
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
}

model Order {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  userId        Int?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String
  phone         String
  address       String        @db.Text
  note          String?       @db.Text
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(UNPAID)
  subtotal      Int
  discount      Int           @default(0)
  shippingFee   Int           @default(0)
  total         Int
  couponCode    String?
  cancelReason  String?       @db.Text
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   Int?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId   Int?
  productName String
  variantName String
  sku         String
  image       String?         @db.VarChar(1000)
  price       Int
  quantity    Int
  total       Int
}

model Coupon {
  id            Int          @id @default(autoincrement())
  code          String       @unique
  description   String?      @db.Text
  type          DiscountType @default(PERCENT)
  value         Int
  minOrderValue Int          @default(0)
  maxDiscount   Int?
  usageLimit    Int?
  usedCount     Int          @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model InventoryLog {
  id         Int             @id @default(autoincrement())
  variantId  Int
  variant    ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change     Int
  stockAfter Int
  reason     InventoryReason
  note       String?         @db.Text
  userId     Int?
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@index([variantId])
}
