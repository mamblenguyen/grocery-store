generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" = runtime của Vercel Functions (build trên GitHub Actions rồi deploy --prebuilt)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  // vd: mysql://root:root@localhost:3306/grocery
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN // quản trị nền tảng
  ADMIN // chủ / quản lý cửa hàng
  STAFF // nhân viên cửa hàng
  CUSTOMER // khách hàng (dùng chung toàn nền tảng)
}

enum StoreStatus {
  ACTIVE
  SUSPENDED // tạm khoá
  CLOSED // ngừng hợp tác
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  VNPAY
  CASH // bán tại quầy
}

enum OrderChannel {
  ONLINE
  POS
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum InventoryReason {
  IMPORT // nhập kho (phiếu nhập / nhập nhanh)
  EXPORT // xuất kho (hư hỏng, hết hạn, trả NCC, nội bộ)
  STOCKTAKE // chênh lệch kiểm kê
  ORDER // bán hàng
  CANCEL // huỷ đơn hoàn kho
  ADJUST // điều chỉnh tay
}

enum StockDocType {
  IMPORT
  EXPORT
  STOCKTAKE
}

enum StockDocStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  password       String
  fullName       String
  phone          String?
  address        String?   @db.Text
  role           Role      @default(CUSTOMER)
  /// Cửa hàng của ADMIN/STAFF; khách hàng & super admin: null
  storeId        Int?
  store          Store?    @relation("StoreMembers", fields: [storeId], references: [id], onDelete: SetNull)
  isActive       Boolean   @default(true)
  resetTokenHash String?
  resetTokenExp  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  notifications Notification[]
  pushTokens    PushToken[]
  orders        Order[]
  createdOrders Order[]         @relation("OrderCreatedBy")
  inventoryLogs InventoryLog[]
  reviews       Review[]
  wishlist      WishlistItem[]
  addresses     Address[]
  docsCreated   StockDocument[] @relation("DocCreatedBy")
  docsCompleted StockDocument[] @relation("DocCompletedBy")
  storePayments StorePayment[]

  @@index([storeId])
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String
  storeId     Int
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  description String?    @db.Text
  image       String?    @db.VarChar(1000)
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  parentId    Int?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([storeId, slug])
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String
  storeId     Int
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  description String?   @db.Text
  brand       String?
  unit        String? // đơn vị tính: gói, chai, hộp, kg...
  thumbnail   String?   @db.VarChar(1000)
  images      Json? // mảng URL ảnh: ["https://...", ...]
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  // Giá thấp nhất / cao nhất trong các biến thể (denormalized để lọc & sắp xếp)
  minPrice    Int       @default(0)
  maxPrice    Int       @default(0)
  soldCount   Int       @default(0)
  ratingAvg   Float     @default(0)
  ratingCount Int       @default(0)
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  options  ProductOption[]
  variants ProductVariant[]
  reviews  Review[]
  wishedBy WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([categoryId])
  @@index([isActive, isFeatured])
}

// Ví dụ: "Khối lượng", "Hương vị"
model ProductOption {
  id        Int                  @id @default(autoincrement())
  productId Int
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int                  @default(0)
  values    ProductOptionValue[]
}

// Ví dụ: "500g", "1kg", "Cay", "Không cay"
model ProductOptionValue {
  id       Int                  @id @default(autoincrement())
  optionId Int
  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value    String
  position Int                  @default(0)
  variants VariantOptionValue[]
}

model ProductVariant {
  id                Int     @id @default(autoincrement())
  productId         Int
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String
  /// trùng với product.storeId – để SKU / mã vạch là duy nhất trong từng cửa hàng
  storeId           Int
  store             Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  barcode           String?
  name              String // "1kg / Cay" – tự sinh từ option values
  price             Int
  compareAtPrice    Int? // giá gốc (gạch ngang)
  costPrice         Int? // giá nhập
  stock             Int     @default(0)
  lowStockThreshold Int     @default(5)
  image             String? @db.VarChar(1000)
  isActive          Boolean @default(true)
  position          Int     @default(0)

  optionValues  VariantOptionValue[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]
  stockDocItems StockDocumentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, sku])
  @@index([productId])
  @@index([barcode])
  @@index([storeId, barcode])
}

model VariantOptionValue {
  variantId     Int
  optionValueId Int
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
}

model Order {
  id            Int                  @id @default(autoincrement())
  code          String               @unique
  storeId       Int
  store         Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId        Int?
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdById   Int? // nhân viên tạo đơn (POS)
  createdBy     User?                @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  channel       OrderChannel         @default(ONLINE)
  deliveryDate  DateTime?            @db.Date
  deliverySlot  String?
  paidAt        DateTime?
  cashReceived  Int? // tiền khách đưa (POS)
  customerName  String
  phone         String
  address       String               @db.Text
  note          String?              @db.Text
  status        OrderStatus          @default(PENDING)
  paymentMethod PaymentMethod        @default(COD)
  paymentStatus PaymentStatus        @default(UNPAID)
  subtotal      Int
  discount      Int                  @default(0)
  shippingFee   Int                  @default(0)
  total         Int
  couponCode    String?
  cancelReason  String?              @db.Text
  items         OrderItem[]
  payments      PaymentTransaction[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([storeId, createdAt])
}

model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   Int?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId   Int?
  productName String
  variantName String
  sku         String
  image       String?         @db.VarChar(1000)
  price       Int
  costPrice   Int? // giá vốn tại thời điểm bán (báo cáo lợi nhuận)
  quantity    Int
  total       Int
}

model Coupon {
  id            Int          @id @default(autoincrement())
  code          String
  storeId       Int
  store         Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  description   String?      @db.Text
  type          DiscountType @default(PERCENT)
  value         Int
  minOrderValue Int          @default(0)
  maxDiscount   Int?
  usageLimit    Int?
  usedCount     Int          @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([storeId, code])
}

model InventoryLog {
  id         Int             @id @default(autoincrement())
  variantId  Int
  variant    ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change     Int
  stockAfter Int
  reason     InventoryReason
  note       String?         @db.Text
  unitCost   Int? // giá vốn của lần nhập/xuất
  documentId Int?
  document   StockDocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  userId     Int?
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@index([variantId])
}

model PaymentTransaction {
  id            Int               @id @default(autoincrement())
  orderId       Int
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      PaymentMethod
  amount        Int
  status        TransactionStatus @default(PENDING)
  txnRef        String            @unique // mã giao dịch gửi sang cổng thanh toán
  transactionNo String? // mã giao dịch phía cổng thanh toán / ngân hàng
  bankCode      String?
  responseCode  String?
  message       String?           @db.Text
  rawData       Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([orderId])
}

/// Cấu hình từng cửa hàng dạng key-value (key "store" chứa toàn bộ cài đặt)
model Setting {
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@id([storeId, key])
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String?  @db.Text
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId, isVisible])
}

model WishlistItem {
  userId    Int
  productId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String? // Nhà riêng, Công ty...
  fullName  String
  phone     String
  address   String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Supplier {
  id          Int             @id @default(autoincrement())
  name        String
  storeId     Int
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  contactName String?
  phone       String?
  email       String?
  address     String?         @db.Text
  taxCode     String?
  note        String?         @db.Text
  isActive    Boolean         @default(true)
  documents   StockDocument[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([storeId])
}

/// Phiếu kho: nhập (PN), xuất (PX), kiểm kê (KK)
model StockDocument {
  id            Int                 @id @default(autoincrement())
  code          String
  storeId       Int
  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type          StockDocType
  status        StockDocStatus      @default(DRAFT)
  supplierId    Int?
  supplier      Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  reason        String? // phiếu xuất: DAMAGED | EXPIRED | RETURN_SUPPLIER | INTERNAL | OTHER
  invoiceNo     String? // số hoá đơn của nhà cung cấp
  note          String?             @db.Text
  totalQuantity Int                 @default(0)
  totalAmount   Int                 @default(0)
  createdById   Int?
  createdBy     User?               @relation("DocCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedById Int?
  completedBy   User?               @relation("DocCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?             @db.Text
  items         StockDocumentItem[]
  logs          InventoryLog[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([storeId, code])
  @@index([type, status])
}

model StockDocumentItem {
  id         Int            @id @default(autoincrement())
  documentId Int
  document   StockDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  variantId  Int
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  /// Nhập/Xuất: số lượng. Kiểm kê: số lượng đếm thực tế
  quantity   Int
  /// Kiểm kê: tồn trên hệ thống tại thời điểm hoàn tất phiếu
  systemQty  Int?
  unitCost   Int            @default(0)
  total      Int            @default(0)
  lotNo      String?
  expiryDate DateTime?      @db.Date
  note       String?

  @@index([documentId])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // ORDER_STATUS | PAYMENT | NEW_ORDER | SYSTEM
  title     String
  body      String    @db.Text
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// Expo push token của thiết bị (app điện thoại)
model PushToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Gói dịch vụ dành cho đối tác
model Plan {
  id           Int            @id @default(autoincrement())
  code         String         @unique
  name         String
  description  String?        @db.Text
  priceMonthly Int            @default(0)
  /// null = không giới hạn
  maxProducts  Int?
  maxStaff     Int?
  isActive     Boolean        @default(true)
  sortOrder    Int            @default(0)
  stores       Store[]
  payments     StorePayment[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

/// Cửa hàng (đối tác) trên nền tảng
model Store {
  id            Int         @id @default(autoincrement())
  slug          String      @unique
  name          String
  phone         String?
  email         String?
  address       String?     @db.Text
  logo          String?     @db.VarChar(1000)
  status        StoreStatus @default(ACTIVE)
  planId        Int?
  plan          Plan?       @relation(fields: [planId], references: [id], onDelete: SetNull)
  /// null = không thời hạn
  planExpiresAt DateTime?
  note          String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  members        User[]           @relation("StoreMembers")
  categories     Category[]
  products       Product[]
  variants       ProductVariant[]
  orders         Order[]
  coupons        Coupon[]
  settings       Setting[]
  suppliers      Supplier[]
  stockDocuments StockDocument[]
  payments       StorePayment[]
}

/// Lịch sử gia hạn / thanh toán gói của đối tác
model StorePayment {
  id          Int      @id @default(autoincrement())
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  planId      Int?
  plan        Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  months      Int
  amount      Int
  periodFrom  DateTime
  periodTo    DateTime
  method      String? // tiền mặt, chuyển khoản…
  note        String?  @db.Text
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([storeId])
}
