DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grocery?schema=public"
# BẮT BUỘC ở production: chuỗi ngẫu nhiên >= 32 ký tự (vd: openssl rand -hex 32).
# Thiếu hoặc ngắn hơn 32 ký tự khi NODE_ENV=production thì app sẽ không khởi động.
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
# Phí ship mặc định và ngưỡng miễn phí ship (VND)
SHIPPING_FEE=20000
FREE_SHIPPING_THRESHOLD=300000
