DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grocery?schema=public"
# Kết nối trực tiếp (không qua pooler) cho prisma migrate. Local: giống DATABASE_URL
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/grocery?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
# Phí ship mặc định và ngưỡng miễn phí ship (VND)
SHIPPING_FEE=20000
FREE_SHIPPING_THRESHOLD=300000
# Vercel Blob (tự có khi gắn Blob store vào project trên Vercel). Để trống => lưu ảnh vào ./uploads
BLOB_READ_WRITE_TOKEN=
# Seed: mặc định chỉ chạy khi DB còn trống. Đặt "true" để XOÁ và seed lại (chỉ dùng ở local!)
FORCE_SEED=false
# Tài khoản admin tạo khi seed DB trống. Bỏ trống => admin@grocery.local / 123456 + tài khoản demo
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
