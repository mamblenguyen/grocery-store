# MySQL: mysql://USER:PASSWORD@HOST:PORT/DATABASE (DB tự được tạo nếu chưa có)
DATABASE_URL="mysql://root:root@localhost:3306/grocery"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:3000,http://localhost:8081"
# Vercel Blob (tự có khi gắn Blob store vào project trên Vercel). Để trống => lưu ảnh vào ./uploads
BLOB_READ_WRITE_TOKEN=
# Seed: mặc định chỉ chạy khi DB còn trống. Đặt "true" để XOÁ và seed lại (chỉ dùng ở local!)
FORCE_SEED=false
# Tài khoản admin tạo khi seed DB trống. Bỏ trống => admin@grocery.local / 123456 + tài khoản demo
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# VNPay (đăng ký sandbox miễn phí: https://sandbox.vnpayment.vn/devreg/). Bỏ trống => ẩn VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return
# URL trang web (dùng trong email đặt lại mật khẩu)
APP_URL=http://localhost:3000
# Email SMTP (quên mật khẩu). Bỏ trống => link đặt lại mật khẩu được in ra log của API
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
